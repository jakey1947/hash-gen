{
  "$schema": "https://raw.githubusercontent.com/vicinaehq/vicinae/refs/heads/main/extra/schemas/extension.json",
  "name": "hash-gen",
  "title": "hash-gen",
  "description": "Generate hashes from text",
  "categories": [],
  "license": "MIT",
  "author": "jakey1947",
  "contributors": [],
  "pastContributors": [],
  "icon": "extension_icon.png",
  "commands": [
    {
      "name": "hash",
      "title": "Hash text",
      "description": "generate the a hash for the given text",
      "mode": "view",
      "arguments": [
        {
          "name": "algorithm",
          "placeholder": "Algorithm",
          "type": "dropdown",
          "required": true,
          "data": [
            {
              "title": "Sha224",
              "value": "sha224"
            },
            {
              "title": "Sha256",
              "value": "sha256"
            },
            {
              "title": "Sha384",
              "value": "sha384"
            },
            {
              "title": "Sha512",
              "value": "sha512"
            },
            {
              "title": "Sha512_224",
              "value": "sha512_224"
            },
            {
              "title": "Sha512_256",
              "value": "sha512_256"
            },
            {
              "title": "Md5",
              "value": "md5"
            }
          ]
        },
        {
          "name": "content",
          "placeholder": "Input Text",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "name": "sha256",
      "title": "Hash text with sha256",
      "description": "generate the a hash for the given text",
      "mode": "view",
      "arguments": [
        {
          "name": "content",
          "placeholder": "Input Text",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "name": "sha512",
      "title": "Hash text with sha512",
      "description": "generate the a hash for the given text",
      "mode": "view",
      "arguments": [
        {
          "name": "content",
          "placeholder": "Input Text",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "name": "md5",
      "title": "Hash text with md5",
      "description": "generate the a hash for the given text",
      "mode": "view",
      "arguments": [
        {
          "name": "content",
          "placeholder": "Input Text",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "name": "sha224",
      "title": "Hash text with sha224",
      "description": "generate the a hash for the given text",
      "mode": "view",
      "arguments": [
        {
          "name": "content",
          "placeholder": "Input Text",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "name": "sha384",
      "title": "Hash text with sha384",
